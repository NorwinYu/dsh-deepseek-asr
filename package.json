{
  "name": "dsh-deepseek-asr",
  "version": "0.1.0",
  "description": "DeepSeek ASR cloud speech-to-text provider for DeepSeek Harness voice input",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "speech-to-text",
    "asr",
    "voice-input"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-experimental-voice-input-bundle": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
